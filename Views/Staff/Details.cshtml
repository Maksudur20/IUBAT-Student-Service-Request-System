@model StudentServiceRequestSystem.ViewModels.RequestDetailsViewModel
@{
    ViewData["Title"] = $"Staff Review - Request #{Model.Id}";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-9">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a asp-controller="Staff" asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-controller="Staff" asp-action="Requests">All Requests</a></li>
                <li class="breadcrumb-item active" aria-current="page">Review #@Model.Id</li>
            </ol>
        </nav>

        <div class="card shadow border-0 rounded-4 bg-white overflow-hidden mb-4">
            <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <span class="fs-4 fw-bold text-dark me-3">Review Request #@Model.Id</span>
                    <span class="badge @Model.Status.ToBadgeClass() status-badge rounded-pill px-3 py-1 fs-6">
                        @Model.Status
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Staff" asp-action="UpdateStatus" asp-route-id="@Model.Id" class="btn btn-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-pencil-square me-1"></i> Change Status
                    </a>
                    <a asp-controller="Staff" asp-action="Requests" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        Back to List
                    </a>
                </div>
            </div>

            <div class="card-body p-4">
                <!-- Student Info Card -->
                <div class="p-3 bg-light rounded-4 border mb-4">
                    <h6 class="fw-bold text-secondary text-uppercase small mb-3">
                        <i class="bi bi-person-circle text-primary me-1"></i> Student Information
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="small text-muted">Student Name</div>
                            <div class="fw-bold text-dark fs-5">@Model.StudentName</div>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">University Email</div>
                            <div class="fw-bold text-dark fs-5">
                                <a href="mailto:@Model.StudentEmail" class="text-decoration-none text-dark">
                                    <i class="bi bi-envelope me-1 text-primary"></i>@Model.StudentEmail
                                </a>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">University ID</div>
                            <div class="fw-bold text-dark">
                                @if (!string.IsNullOrEmpty(Model.StudentUniversityId))
                                {
                                    <span class="badge bg-white text-primary border fs-6"><i class="bi bi-person-badge me-1"></i>@Model.StudentUniversityId</span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="small text-muted">Department / Program</div>
                            <div class="fw-semibold text-dark">
                                @if (!string.IsNullOrEmpty(Model.StudentDepartment))
                                {
                                    <i class="bi bi-mortarboard me-1 text-secondary"></i>@Model.StudentDepartment
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Request Parameters -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light-subtle rounded-3 border">
                            <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Service Type</span>
                            <span class="fs-5 fw-bold text-dark">
                                <i class="bi bi-tag text-primary me-2"></i>@Model.RequestType.ToFriendlyName()
                            </span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light-subtle rounded-3 border">
                            <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Date Submitted</span>
                            <span class="fs-5 fw-bold text-dark">
                                <i class="bi bi-clock-history text-primary me-2"></i>@Model.RequestDate.ToDisplayDateTime("dd MMMM yyyy, hh:mm tt")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="mb-4">
                    <h6 class="fw-bold text-secondary text-uppercase small mb-2">Student Description</h6>
                    <div class="p-3 bg-light rounded-3 border text-dark" style="white-space: pre-line; line-height: 1.6;">
                        @Model.Description
                    </div>
                </div>

                <!-- Staff Remarks -->
                <div class="mb-4">
                    <h6 class="fw-bold text-secondary text-uppercase small mb-2">Current Staff Remarks</h6>
                    @if (!string.IsNullOrEmpty(Model.StaffRemarks))
                    {
                        <div class="p-3 bg-primary-subtle rounded-3 border border-primary-subtle text-dark">
                            @Model.StaffRemarks
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <div class="mt-2 text-muted small">
                                    <i class="bi bi-check2-circle me-1"></i> Last updated: @Model.UpdatedAt.ToDisplayDateTime("dd MMM yyyy, hh:mm tt")
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-3 bg-light rounded-3 border text-muted small fst-italic">
                            No internal remarks or instructions entered yet. Click "Change Status" above to add remarks for the student.
                        </div>
                    }
                </div>

                <div class="pt-3 border-top d-flex justify-content-end gap-2">
                    <a asp-controller="Staff" asp-action="UpdateStatus" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-arrow-repeat me-1"></i> Update Status & Remarks
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
