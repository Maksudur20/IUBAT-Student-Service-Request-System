@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 text-center">
        <div class="card shadow-sm border-0 rounded-4 p-5 bg-white">
            <div class="mb-3 text-warning">
                <i class="bi bi-shield-x" style="font-size: 4.5rem;"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">403 - Access Denied</h2>
            <p class="text-muted lead mb-4">
                You do not have the required role permissions to access this university resource.
            </p>
            <div class="alert alert-warning border-0 rounded-3 text-start small mb-4">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Security Enforcement:</strong> Access to staff management consoles and requests belonging to other students is strictly restricted by role-based authorization and ownership filters.
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-house me-1"></i> Go to Dashboard / Home
                </a>
            </div>
        </div>
    </div>
</div>
