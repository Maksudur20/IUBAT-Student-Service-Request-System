@model StudentServiceRequestSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow border-0 rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <img src="~/images/iubat-logo.png" alt="IUBAT Logo" class="mb-3" style="height: 64px; width: auto;" />
                <h3 class="fw-bold text-dark mb-1">Account Login</h3>
                <p class="text-muted small">Sign in to your Student or Staff account</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control border-start-0" placeholder="name@university.com" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <label asp-for="Password" class="form-label fw-semibold small text-secondary"></label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="Password" class="form-control border-start-0" placeholder="••••••••" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
                    <label class="form-check-label small text-secondary" asp-for="RememberMe">
                        Keep me signed in
                    </label>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-semibold shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </div>
            </form>

            <div class="text-center pt-3 border-top mt-2">
                <span class="text-muted small">New student at IUBAT? </span>
                <a asp-controller="Account" asp-action="Register" class="fw-bold text-decoration-none">Create an account</a>
            </div>

            <!-- Pre-seeded credentials banner for rapid grading/testing -->
            <div class="mt-4 p-3 bg-light border rounded-3 small">
                <div class="fw-bold text-dark mb-1 d-flex align-items-center">
                    <i class="bi bi-info-circle-fill text-primary me-1"></i> Default Demo Credentials:
                </div>
                <div class="text-muted">
                    <strong>Staff Account:</strong> <code>admin@university.com</code> / <code>Admin@123456</code><br />
                    <strong>Student Account:</strong> <code>student@iubat.edu</code> / <code>Student@123456</code>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
