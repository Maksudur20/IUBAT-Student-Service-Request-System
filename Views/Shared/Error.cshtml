@model StudentServiceRequestSystem.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 text-center">
        <div class="card shadow-sm border-0 rounded-4 p-5">
            <div class="mb-3 text-danger">
                <i class="bi bi-exclamation-octagon-fill" style="font-size: 4rem;"></i>
            </div>
            <h1 class="h3 fw-bold text-danger mb-2">An error occurred while processing your request</h1>
            <p class="text-muted mb-4">We apologize for the inconvenience. Please try again later or return to the main portal.</p>

            @if (Model.ShowRequestId)
            {
                <p class="small text-muted">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <div class="mt-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-house me-1"></i> Return Home
                </a>
            </div>
        </div>
    </div>
</div>
