@model IEnumerable<StudentServiceRequestSystem.ViewModels.StudentRequestItemViewModel>
@using StudentServiceRequestSystem.Models
@{
    ViewData["Title"] = "My Service Requests";
    var currentFilter = ViewData["CurrentFilter"] as RequestStatus?;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="fw-bold text-dark mb-1">My Service Requests</h2>
        <p class="text-muted mb-0">Track and view all service requests submitted under your student account</p>
    </div>
    <div class="mt-3 mt-md-0 flex-shrink-0">
        <a asp-controller="Student" asp-action="CreateRequest" class="btn btn-primary rounded-pill px-4 shadow-sm text-nowrap">
            <i class="bi bi-plus-circle me-1"></i> Submit New Request
        </a>
    </div>
</div>

<!-- Status Filter Pills -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-controller="Student" asp-action="MyRequests" class="btn btn-sm rounded-pill @(currentFilter == null ? "btn-dark fw-semibold" : "btn-outline-secondary")">
        All Requests
    </a>
    <a asp-controller="Student" asp-action="MyRequests" asp-route-statusFilter="@RequestStatus.Pending" class="btn btn-sm rounded-pill @(currentFilter == RequestStatus.Pending ? "btn-warning text-dark fw-semibold" : "btn-outline-warning text-dark")">
        <i class="bi bi-hourglass-split me-1"></i> Pending
    </a>
    <a asp-controller="Student" asp-action="MyRequests" asp-route-statusFilter="@RequestStatus.Processing" class="btn btn-sm rounded-pill @(currentFilter == RequestStatus.Processing ? "btn-primary fw-semibold" : "btn-outline-primary")">
        <i class="bi bi-gear-wide me-1"></i> Processing
    </a>
    <a asp-controller="Student" asp-action="MyRequests" asp-route-statusFilter="@RequestStatus.Completed" class="btn btn-sm rounded-pill @(currentFilter == RequestStatus.Completed ? "btn-success fw-semibold" : "btn-outline-success")">
        <i class="bi bi-check2-circle me-1"></i> Completed
    </a>
    <a asp-controller="Student" asp-action="MyRequests" asp-route-statusFilter="@RequestStatus.Rejected" class="btn btn-sm rounded-pill @(currentFilter == RequestStatus.Rejected ? "btn-danger fw-semibold" : "btn-outline-danger")">
        <i class="bi bi-x-circle me-1"></i> Rejected
    </a>
</div>

<!-- Request Table -->
<div class="card shadow-sm border-0 rounded-4 bg-white overflow-hidden">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-nowrap">
                    <thead class="table-light text-secondary small">
                        <tr>
                            <th class="ps-4 text-nowrap" style="width: 80px;">Request ID</th>
                            <th class="text-nowrap">Service Type</th>
                            <th class="text-nowrap">Description</th>
                            <th class="text-nowrap">Submitted</th>
                            <th class="text-nowrap">Status</th>
                            <th class="text-nowrap">Staff Remarks</th>
                            <th class="text-end pe-4 text-nowrap" style="min-width: 120px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary text-nowrap">#@item.Id</td>
                                <td class="text-nowrap">
                                    <span class="badge bg-light text-dark border">
                                        @item.RequestType.ToFriendlyName()
                                    </span>
                                </td>
                                <td class="text-nowrap" style="max-width: 300px;">
                                    <span class="small text-muted text-truncate d-inline-block" style="max-width: 280px;" title="@item.Description">
                                        @item.Description
                                    </span>
                                </td>
                                <td class="text-muted small text-nowrap">@item.RequestDate.ToDisplayDateTime("dd MMM, hh:mm tt")</td>
                                <td class="text-nowrap">
                                    <span class="badge @item.Status.ToBadgeClass() status-badge rounded-pill">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-nowrap" style="max-width: 240px;">
                                    @if (!string.IsNullOrEmpty(item.StaffRemarks))
                                    {
                                        <span class="small text-dark text-truncate d-inline-block" style="max-width: 220px;" title="@item.StaffRemarks">
                                            <i class="bi bi-chat-left-dots text-primary me-1"></i>@item.StaffRemarks
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">None</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <a asp-controller="Student" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 text-nowrap d-inline-flex align-items-center">
                                        <i class="bi bi-eye me-1"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-3 text-muted">
                    <i class="bi bi-clipboard-x fs-1"></i>
                </div>
                <h5 class="fw-bold text-dark">No requests found</h5>
                <p class="text-muted small mb-3">There are no service requests matching the selected filter.</p>
                <a asp-controller="Student" asp-action="CreateRequest" class="btn btn-primary btn-sm rounded-pill px-4">
                    <i class="bi bi-plus-circle me-1"></i> Create New Request
                </a>
            </div>
        }
    </div>
</div>
