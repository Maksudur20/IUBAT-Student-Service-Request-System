@model StudentServiceRequestSystem.ViewModels.RequestDetailsViewModel
@{
    ViewData["Title"] = $"Request #{Model.Id} Details";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-9">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a asp-controller="Student" asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-controller="Student" asp-action="MyRequests">My Requests</a></li>
                <li class="breadcrumb-item active" aria-current="page">Request #@Model.Id</li>
            </ol>
        </nav>

        <div class="card shadow border-0 rounded-4 bg-white overflow-hidden mb-4">
            <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <span class="fs-4 fw-bold text-dark me-3">Request #@Model.Id</span>
                    <span class="badge @Model.Status.ToBadgeClass() status-badge rounded-pill px-3 py-1 fs-6">
                        @Model.Status
                    </span>
                </div>
                <a asp-controller="Student" asp-action="MyRequests" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>

            <div class="card-body p-4">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Service Type</span>
                            <span class="fs-5 fw-bold text-dark">
                                <i class="bi bi-tag-fill text-primary me-2"></i>@Model.RequestType.ToFriendlyName()
                            </span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Submission Date</span>
                            <span class="fs-5 fw-bold text-dark">
                                <i class="bi bi-calendar3 text-primary me-2"></i>@Model.RequestDate.ToDisplayDateTime("dd MMMM yyyy, hh:mm tt")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-secondary text-uppercase small mb-2">Request Description</h6>
                    <div class="p-3 bg-light-subtle rounded-3 border text-dark" style="white-space: pre-line; line-height: 1.6;">
                        @Model.Description
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.StaffRemarks))
                {
                    <div class="mb-4">
                        <h6 class="fw-bold text-primary text-uppercase small mb-2">
                            <i class="bi bi-chat-square-quote-fill me-1"></i> University Staff Remarks
                        </h6>
                        <div class="p-3 bg-primary-subtle rounded-3 border border-primary-subtle text-dark">
                            @Model.StaffRemarks
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <div class="mt-2 text-muted small">
                                    <i class="bi bi-clock-history me-1"></i> Updated on @Model.UpdatedAt.ToDisplayDateTime("dd MMM yyyy, hh:mm tt")
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Status Progress Indicator -->
                <div class="mt-4 pt-4 border-top">
                    <h6 class="fw-bold text-secondary text-uppercase small mb-3">Lifecycle Progress</h6>
                    <div class="row text-center g-2">
                        <div class="col-3">
                            <div class="p-2 rounded-3 @(Model.Status >= StudentServiceRequestSystem.Models.RequestStatus.Pending ? "bg-warning text-dark fw-bold" : "bg-light text-muted")">
                                1. Submitted
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded-3 @(Model.Status >= StudentServiceRequestSystem.Models.RequestStatus.Processing && Model.Status != StudentServiceRequestSystem.Models.RequestStatus.Rejected ? "bg-primary text-white fw-bold" : "bg-light text-muted")">
                                2. Processing
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded-3 @(Model.Status == StudentServiceRequestSystem.Models.RequestStatus.Completed ? "bg-success text-white fw-bold" : "bg-light text-muted")">
                                3. Completed
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="p-2 rounded-3 @(Model.Status == StudentServiceRequestSystem.Models.RequestStatus.Rejected ? "bg-danger text-white fw-bold" : "bg-light text-muted")">
                                Rejected
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
