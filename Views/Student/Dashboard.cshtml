@model StudentServiceRequestSystem.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
    <div class="me-md-3 mb-2 mb-md-0">
        <h2 class="fw-bold text-dark mb-1">Student Dashboard</h2>
        <div class="d-flex flex-wrap align-items-center gap-2 text-muted mb-0">
            <span>Welcome back, <strong>@Model.StudentName</strong></span>
            @if (!string.IsNullOrEmpty(Model.UniversityId))
            {
                <span class="badge bg-light text-primary border"><i class="bi bi-person-badge me-1"></i>ID: @Model.UniversityId</span>
            }
            @if (!string.IsNullOrEmpty(Model.Department))
            {
                <span class="badge bg-light text-secondary border"><i class="bi bi-mortarboard me-1"></i>@Model.Department</span>
            }
            <span class="small text-muted">(@Model.StudentEmail)</span>
        </div>
    </div>
    <div class="mt-2 mt-md-0 d-flex gap-2 flex-shrink-0">
        <a asp-controller="Student" asp-action="CreateRequest" class="btn btn-primary rounded-pill shadow-sm px-3 text-nowrap">
            <i class="bi bi-plus-circle me-1"></i> Submit New Request
        </a>
        <a asp-controller="Student" asp-action="MyRequests" class="btn btn-outline-secondary rounded-pill px-3 text-nowrap">
            <i class="bi bi-list-ul me-1"></i> View All Requests
        </a>
    </div>
</div>

<!-- KPI Metrics -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100 border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Total Requests</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalRequests</h3>
                </div>
                <div class="icon-circle icon-circle-md bg-primary-subtle text-primary">
                    <i class="bi bi-folder2-open"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100 border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Pending</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@Model.PendingRequests</h3>
                </div>
                <div class="icon-circle icon-circle-md bg-warning-subtle text-warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100 border-start border-4 border-info">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Processing</span>
                    <h3 class="fw-bold text-info mb-0 mt-1">@Model.ProcessingRequests</h3>
                </div>
                <div class="icon-circle icon-circle-md bg-info-subtle text-info">
                    <i class="bi bi-gear-wide-connected"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm border-0 rounded-4 p-3 bg-white h-100 border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Completed</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.CompletedRequests</h3>
                </div>
                <div class="icon-circle icon-circle-md bg-success-subtle text-success">
                    <i class="bi bi-check2-circle"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Requests -->
<div class="card shadow-sm border-0 rounded-4 bg-white overflow-hidden">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-dark mb-0">Recent Service Requests</h5>
        <a asp-controller="Student" asp-action="MyRequests" class="btn btn-sm btn-link text-primary text-decoration-none fw-semibold">
            View All (@Model.TotalRequests) &rarr;
        </a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentRequests.Any())
        {
            <div class="table-responsive table-scroll-container">
                <table class="table table-hover align-middle mb-0 text-nowrap" style="min-width: 800px;">
                    <thead class="table-light text-secondary small">
                        <tr>
                            <th class="ps-4">Request ID</th>
                            <th>Request Type</th>
                            <th>Submitted Date</th>
                            <th>Status</th>
                            <th>Staff Remarks</th>
                            <th class="text-end pe-4 text-nowrap" style="min-width: 120px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.RecentRequests)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@request.Id</td>
                                <td>
                                    <span class="fw-semibold text-dark">@request.RequestType.ToFriendlyName()</span>
                                </td>
                                <td class="text-muted small">@request.RequestDate.ToDisplayDateTime("dd MMM yyyy, hh:mm tt")</td>
                                <td>
                                    <span class="badge @request.Status.ToBadgeClass() status-badge rounded-pill">
                                        @request.Status
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(request.StaffRemarks))
                                    {
                                        <span class="small text-dark text-truncate d-inline-block" style="max-width: 250px;" title="@request.StaffRemarks">
                                            <i class="bi bi-chat-left-text text-muted me-1"></i>@request.StaffRemarks
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">No remarks yet</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <a asp-controller="Student" asp-action="Details" asp-route-id="@request.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 text-nowrap d-inline-flex align-items-center">
                                        <i class="bi bi-eye me-1"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-3 text-muted">
                    <i class="bi bi-inbox fs-1"></i>
                </div>
                <h6 class="fw-bold text-dark">No service requests submitted yet</h6>
                <p class="text-muted small mb-3">You can submit your first request online in under a minute.</p>
                <a asp-controller="Student" asp-action="CreateRequest" class="btn btn-primary btn-sm rounded-pill px-4">
                    <i class="bi bi-plus-circle me-1"></i> Submit Request Now
                </a>
            </div>
        }
    </div>
</div>
